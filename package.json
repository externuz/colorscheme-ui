{
  "name": "colorscheme-ui",
  "version": "0.4.5",
  "description": "Flat, accessible React UI components powered by Base UI, CSS Modules, and iconic editor colorschemes (Tokyo Night, Catppuccin, Gruvbox).",
  "type": "module",
  "license": "MIT",
  "author": "Vladislav Kolesnikov (https://github.com/externuz)",
  "homepage": "https://externuz.github.io/colorscheme-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/externuz/colorscheme-ui.git"
  },
  "bugs": {
    "url": "https://github.com/externuz/colorscheme-ui/issues"
  },
  "keywords": [
    "colorscheme-ui",
    "react",
    "react-components",
    "component-library",
    "ui",
    "ui-kit",
    "components",
    "colorscheme",
    "color-scheme",
    "tokyo-night",
    "catppuccin",
    "catppuccin-mocha",
    "catppuccin-latte",
    "gruvbox",
    "neovim",
    "base-ui",
    "headless",
    "css-modules",
    "design-system",
    "theming",
    "dark-mode",
    "light-mode",
    "accessible"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./reset.css": "./dist/reset.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "lucide-react": "^1.71.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
